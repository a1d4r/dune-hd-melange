# PHPStan typeAliases syntax; the config of the check is not published in this repository.
# Shapes of the main arrays of plugin/melange, for the PHPDoc of its code
# (@param AioRow $r ...). The code is PHP 5.3, so the types live in comments
# only and are checked by PHPStan; this file is not in the zip. The meaning of
# each key is in the comment of the function that makes the array.
parameters:
    typeAliases:
        # A server of "Download to server" (aio_server_conf, common.php).
        AioServer: 'array{name: string, url: string, user: string, pass: string, category: string, tags: string, cache: string}'
        # A config of AIOStreams made by the settings page (aio_aio_conf, common.php).
        AioConf: 'array{uuid: string, pass: string, manifest: string, tmdb: bool, set: list<string>|null, tpl: string|null}'
        # A JacRed to ask (aio_jacred_conf, aio_jacred_builtin_conf, common.php).
        AioJacred: 'array{base: string, host: string, key: string, key_url: string, builtin?: bool}'
        # settings.json as read (aio_settings_read, common.php).
        AioSettings: '''
            array{
                source: 'made'|'own',
                manifest_url: string,
                rd_key: string,
                tb_key: string,
                jacred: string,
                jacred_own_url: string,
                jacred_own_key: string,
                aio_server: string,
                aio_own_url: string,
                aio_tpl: string,
                tmdb_key: string,
                servers: list<AioServer>,
                ts_url: string,
                aio_confs: array<string, AioConf>
            }
        '''
        # Settings of the operation (Aio::$settings, aio_settings_load, main.php).
        AioOpSettings: '''
            array{
                base: string,
                jrs: list<AioJacred>,
                jrm: list<AioJacred>,
                servers: list<AioServer>,
                pw: list<string>,
                ts: string,
                aio: string,
                own: bool,
                hosts: array<string, string>
            }
        '''
        # Badges of a release (aio_badges, parse.php).
        AioBadges: 'array{res: string, src: string, vis: string, ai: bool, audio: list<string>, tags: list<string>}'
        # An audio track of the media info (aio_tracks, parse.php).
        AioTrack: 'array{lang: string, codec: string, ch: string, title: string}'
        # Tracks of a release by infoHash, from ffprobe of JacRed (aio_jacred,
        # jacred.php); a row (AioRow) is one too (aio_carry_tracks).
        AioMedia: 'array{tracks: list<AioTrack>, subs: list<string>}'
        # An add-on that found the release (aio_addons, parse.php).
        AioAddon: 'array{addon: string, cached: bool}'
        # A row of the stream list (aio_row, parse.php). names: until
        # aio_row_voices (voices_parse.php) puts voices in its place.
        AioRow: '''
            array{
                url: string,
                hash: string,
                cached: bool|null,
                service: string,
                resolution: string,
                badges: AioBadges,
                audio_full: string,
                tracks: list<AioTrack>,
                subs: list<string>,
                group: string,
                expr: string,
                network: string,
                pack: float,
                rate: float,
                rate_approx: bool,
                rate_src: string,
                quality: string,
                size: float,
                langs: list<string>,
                trackers: list<string>,
                addon: string,
                addons: list<AioAddon>,
                pf_seasons: list<int>|null,
                pf_episodes: list<int>,
                names?: array{string, string},
                voices?: AioVoices,
                label: string,
                raw: array<mixed>
            }
        '''
        # The card of play_action (aio_movie, main.php).
        AioMovie: '''
            array{
                series: bool,
                imdb: string,
                dune_id: string,
                title: string,
                native: string,
                year: string,
                poster: string,
                fanart: string,
                rate_imdb: string,
                seasons: array<int, int>
            }
        '''
        # A stream list (Aio::$state, aio_list_state, main.php); gc (sel, top:
        # the last cursor), gc_new, gc_prog: of view_gcomps.php.
        AioState: '''
            array{
                rid: string,
                movie: AioMovie,
                s: int,
                e: int,
                rows: list<AioRow>,
                lang: string,
                gc?: array{int, int},
                gc_new?: bool,
                gc_prog?: AioProgress
            }
        '''
        # Of the shell: a GuiAction (handler_string_id, data, params, ...),
        # its fields by the handler (aio_error, aio_input, main.php).
        AioAction: 'array<string, mixed>'
        # The stream check of a URL, by its redirect (aio_pre_class,
        # playback.php): the CDN, a placeholder video of the add-on (its file)
        # or of ElfHosted (aio_pre_slate), else unclear.
        AioPreClass: '''
            array{class: 'stream', url: string, host: string}
            |array{class: 'placeholder', file: string}
            |array{class: 'placeholder', slate: string, infringing: bool}
            |array{class: 'unclear', why: string}
        '''
        # The stream check (aio_precheck, playback.php): of aio_pre_class, a
        # placeholder with the key and detail of its message.
        AioPrecheck: '''
            array{class: 'stream', url: string, host: string}
            |array{class: 'placeholder', file: string, key: string, detail: string}
            |array{class: 'placeholder', slate: string, infringing: bool, key: string, detail: string}
            |array{class: 'unclear', why: string}
        '''
        # The card of a playlist with lazy episodes (Aio::$movies,
        # aio_movie_save, aio_movie_load, playback.php).
        AioLazyMovie: 'array{movie: AioMovie, lang: string}'
        # What plays (Aio::$playing, aio_playing, playback.php): rid of the
        # list screen under the player ('' none), the list state, its row.
        AioPlaying: 'array{from: string, st: AioState, sel: int}'
        # A stream request (aio_fetch, main.php).
        AioFetch: 'array{rows: list<AioRow>}|array{error: string, detail: string}'
        # Progress of the releases of a list (aio_wh_progress, history.php):
        # the tail of our uid of the history after "aio:<dune id>:<s>:<e>:" =>
        # share in (0, 1]. Our uids end in an infoHash (40 hex: a string key);
        # a record of the history not written by us may end in a decimal
        # number, which PHP makes an int key - no infoHash matches it.
        AioProgress: 'array<int|string, float>'
        # Words of the list screen (aio_gc_text, view_gcomps.php).
        AioGcText: '''
            array{
                lang: string, page: string, pack: string, release: string, source: string,
                cached: string, cached_in: string, download: string, unknown: string, p2p: string,
                video: string, audio: string, voices: string, subs: string, langs: string,
                trackers: string, addon: string, flip: string
            }
        '''
        # Columns of the list (aio_gc_cols, view_gcomps.php): x and width;
        # an empty column is not there.
        AioGcCols: '''
            array{
                icon: array{int, int},
                res?: array{int, int},
                src?: array{int, int},
                vis?: array{int, int},
                audio?: array{int, int},
                size?: array{int, int},
                langs?: array{int, int},
                tracker?: array{int, int}
            }
        '''
        # GComps of the shell (gcomps.php). GCompAlignDef: its non-zero
        # fields only (aio_gc_align).
        AioGcAlign: 'array<string, bool|int|string>'
        # GCompGeometryDef (aio_gc_geom).
        AioGcGeom: 'array{w: int, h: int, align_def?: AioGcAlign}'
        # GComponentDef of a label, rect, picture or panel (aio_gc_ttf,
        # aio_gc_rect, aio_gc_image, aio_gc_panel); specific_def by the kind.
        AioGcComp: '''
            array{
                id?: string|null,
                geom_def: AioGcGeom,
                margins_def?: null,
                options?: int,
                kind: string,
                specific_def: array<string, mixed>
            }
        '''
        # ChangeGCompDef of change_gcomps (aio_gc_change).
        AioGcChange: '''
            array{
                id: string,
                geom_def: AioGcGeom|null,
                props: null,
                view_position: null,
                selected: null,
                children: list<AioGcComp>|null,
                transition: string
            }
        '''
        # Voices of one release name (aio_voices_parse, voices_parse.php):
        # type ids (dub, mvo, dvo, avo) in the order of the name, studios
        # shown, orig '' | 'orig' | 'jap', the name without JacRed's tails,
        # keys: studio => its key of voices.php, stype: studio => its type id.
        AioVoicesName: '''
            array{
                types: list<string>,
                studios: list<string>,
                orig: string,
                subs: bool,
                name: string,
                keys: array<string, string>,
                stype: array<string, string>
            }
        '''
        # Voices of a row from its names (aio_voices, voices_parse.php); ua:
        # "(УКР.)" in a name (aio_row_voices).
        AioVoices: '''
            array{
                types: list<string>,
                studios: list<string>,
                orig: string,
                subs: bool,
                stype: array<string, string>,
                ua?: true
            }
        '''
        # What the "Voices" field shows (aio_row_voices_struct,
        # voices_parse.php): groups: type id (dub, mvo, dvo, avo) => its
        # studios, types without studios, studios without a type.
        AioVoicesStruct: '''
            array{
                groups: array<string, list<string>>,
                types: list<string>,
                studios: list<string>,
                orig: string,
                subs: bool
            }
        '''
        # Tokens of a name (aio_voices_tokens, voices_parse.php), by word from
        # 0: as written, lower case, the joint to the next, the separator after
        # it, its part between "|", its depth in brackets, inside the leading
        # "[...]"; then where each "|" is, from 1.
        AioVoicesTokens: '''
            array{
                list<string>,
                list<string>,
                list<string>,
                list<string>,
                list<int>,
                list<int>,
                list<bool>,
                array<int, int>
            }
        '''
        # What a word of a name is (aio_voices_classes, voices_parse.php):
        # kind and id; a studio: its name shown and its key.
        AioVoicesClass: '''
            array{'studio', string, string}
            |array{'in'|'n', ''}
            |array{'type'|'code'|'orig'|'subs', string}
        '''
        # A side of brackets of a track title (aio_voices_side, voices_parse.php).
        AioVoicesSide: 'array{studios: list<string>, n: int, other: bool}'
