# PHPStan typeAliases syntax; the config of the check is not published in this repository.
# Shapes of the main arrays of plugin/melange, for the PHPDoc of its code
# (@param MelRow $r ...). The code is PHP 5.3, so the types live in comments
# only and are checked by PHPStan; this file is not in the zip. The meaning of
# each key is in the comment of the function that makes the array.
parameters:
    typeAliases:
        # A row of the catalog (mel_cat_row, catalog.php); q: the query of a search (mel_cat_search_row), sid: its id (mel_catv_search_run).
        MelCatRow: 'array{key: string, type: string, id: string, name: string, genre: string, home: bool, group: string, q?: string, sid?: string}'
        # A tile of a row (mel_cat_tile, catalog.php).
        MelCatTile: 'array{id: string, imdb_id: string, _tmdbId: string, type: string, name: string, year: string, imdbRating: string, description: string, genres: list<string>, poster: string, background: string, country: string, runtime: string, age: string, ageUs: string, cast: list<string>, englishTitle: string, kpRating: string, kpVotes: int, kpId: string, logo: string, logoLang: string, originalLanguage: string}'
        # An entry of "Мой список" (mel_ml_clean, my_list.php): key - type:<IMDb | tmdb:<id>>; dune_id '' - not known; added - unix time.
        MelMlEntry: 'array{key: string, type: string, name: string, englishTitle: string, year: string, poster: string, background: string, imdb_id: string, _tmdbId: string, kpId: string, imdbRating: string, kpRating: string, kpVotes: int, dune_id: string, added: int}'
        # A hidden title (mel_ht_clean, hidden_titles.php): key - as of MelMlEntry; hidden - unix time, 0 for none.
        MelHtEntry: 'array{key: string, type: string, imdb_id: string, _tmdbId: string, name: string, year: string, hidden: int}'
        # A movie of the Favorites of the Dune (mel_ml_fav_read, my_list.php).
        MelMlFav: 'array{dune_id: string, type: string, name: string, year: string, poster: string, file: string}'
        # A listing of a row (mel_cat_row_state, catalog.php).
        MelCatState: 'array{row: MelCatRow, t0: int, skip: int, end: string, seen: array<string, bool>}'
        # A result of a listing or a search (mel_cat_more, catalog.php).
        MelCatResult: 'array{tiles: list<MelCatTile>, reset: bool, end: bool, stale: bool, err: string}'
        # The rows of the manifest (mel_cat_manifest, catalog.php).
        MelCatRows: 'array{rows: list<MelCatRow>, stale: bool, err: string}'
        # The copy of a page in the cache (mel_cat_page_cached, catalog.php).
        MelCatCached: 'array{t: int, n: int, data: list<MelCatTile>}'
        # A listing on the screen, tiles by their id (mel_catv_list, view_catalog.php); restored: of a copy, not in memory before (mel_catv_list_restore).
        MelCatList: 'array{st: MelCatState, tiles: array<int|string, MelCatTile>, stale: bool, restored?: bool}'
        # A server of "Download to server" (mel_server_conf, common.php).
        MelServer: 'array{name: string, url: string, user: string, pass: string, category: string, tags: string, cache: string, type: string}'
        # A reply of TorrServer (mel_ts_call, net.php).
        MelTsReply: 'array{code: int, body: string, err: string, errno: int}'
        # A reply of the Transmission RPC (mel_trm_call, net.php).
        MelTrmReply: 'array{code: int, body: string, err: string, errno: int, sid: bool}'
        # A reply of Lampac (mel_lp_get, net.php).
        MelLpReply: 'array{code: int, body: string, err: string, errno: int, hit: bool, loc: string}'
        # The parameters of a title for Lampac (mel_lp_title, lampac.php).
        MelLpTitle: 'array{id: string, imdb_id: string, kinopoisk_id: string, title: string, original_title: string, serial: string, year: string, original_language: string, source: string}'
        # The ids of a card kept for the search of Lampac (MelLpv::$ids, mel_lpv_ids_put, online_play.php): keys of mel_lp_title;
        # title (of Lampac, fix_title) and title_of (the title of the card it replaced) only when Lampac gave one.
        MelLpvIds: 'array{tmdb: string, kp: string, original_language: string, title?: string, title_of?: string}'
        # A source of a search of Lampac (mel_lp_source, lampac.php).
        MelLpSource: 'array{name: string, label: string, q: string, url: string, path: string, index: int, pos: int}'
        # A search of Lampac between the ticks (mel_lp_search_start, lampac.php).
        MelLpSearch: 'array{base: string, q: string, mode: string, memkey: string, seen: int, t0: float, sources: list<MelLpSource>, gone: array<string, string>, hidden: array{show: int, rch: int, bad: int}, tasks: int, pending: int, shown: int, fails: int, done: bool, capped: bool, err: string, detail: string, title: string}'
        # A reason of a source of Lampac (mel_lp_why, lampac.php); at: the index of its source (mel_lp_replies).
        MelLpWhy: 'array{src: string, path: string, why: string, detail: string, at?: int}'
        # A row of a reply of a balancer (mel_lp_movie, mel_lp_season_rows, lampac.php); method play|call|season (its episode: mel_lp_ep_row).
        MelLpRow: 'array{path: string, src: string, voice: string, quality: string, method: string, url: string, stream: string, qual: array<string, string>, subs: int, key: string, tracks?: list<string>, tracks_by?: array<int, list<string>>}'
        # A reply of a balancer (mel_lp_reply, lampac.php).
        MelLpParsed: 'array{kind: string, rows: list<MelLpRow>, why: list<MelLpWhy>}'
        # The replies of the sources (mel_lp_replies, lampac.php).
        MelLpReplies: 'array{rows: list<MelLpRow>, at: list<int>, why: list<MelLpWhy>, done: int, left: int, similar: int, serial: int, asked: int, lost: float, again: list<int>, held: array<int, MelLpReply>}'
        # The poll of the replies of a search tick by tick (mel_lp_poll_start, lampac.php).
        MelLpPoll: 'array{t1: float, lost: float, again: list<int>, held: array<int, MelLpReply>, at: list<int>}'
        # The link of "call" (mel_lp_call, lampac.php).
        MelLpLink: 'array{url: string, qual: array<string, string>, err: string, detail: string, tries: int}'
        # The check of a link (mel_lp_check, lampac.php).
        MelLpCheck: 'array{class: string, url: string, why: string, detail: string, hls: bool, no_seek: bool}'
        # A voice of a season of a balancer (mel_lp_season, lampac.php): its name, the link of the season in it.
        MelLpVoice: 'array{name: string, url: string, active: bool}'
        # An episode of a season of a balancer (mel_lp_season, lampac.php; s -1: none in the reply).
        MelLpEp: 'array{s: int, e: int, name: string, method: string, url: string, stream: string, qual: array<string, string>, subs: int, why: string, detail: string}'
        # A season of a balancer (mel_lp_season_reply, lampac.php).
        MelLpSeason: 'array{url: string, voices: list<MelLpVoice>, eps: list<MelLpEp>, quality: string, why: string, detail: string, tracks?: array<int, list<string>>, blocked?: bool, voice?: string}'
        # The row of an episode of a key of the history (mel_lp_find, lampac.php).
        MelLpFound: 'array{row: MelLpRow|null, why: string, detail: string, have: list<int>, voice: string, sea: MelLpSeason|null}'
        # The online list of a list state (MelState lp, view_online.php): the title asked, the sources of the
        # search, the hidden, the rows (in the order of "Источники…"), the reasons, the next source not asked and
        # the number left, the start of the search (mel_lp_now), the yellow line; the cursor as MelState's, of its lines (mel_lpv_lines);
        # the filter by voices: their keys => names, in the order of mel_lpv_voices (none: all); flt_gone - the yellow line is of a filter gone (mel_lpv_flt_keep);
        # off - the paths of the sources of the search turned off in "Источники…" (mel_lpv_srcs_pick), not asked; open - the paths of the
        # balancers unfolded (mel_lpv_lines; none: all folded).
        MelLpView: 'array{title: MelLpTitle, q: string, sources: list<MelLpSource>, hidden: array{show: int, rch: int, bad: int}, rows: list<MelLpRow>, why: list<MelLpWhy>, next: int, left: int, t: float, note: string, gc?: array{int, int}, gc_new?: bool, gc_prog?: MelProgress, flt?: non-empty-array<string, string>, flt_gone?: bool, off?: list<string>, open?: array<string, bool>}'
        # A line of the online list on screen (mel_lpv_lines, view_online.php): k its kind, i its row, n the rows of a
        # balancer, q its quality.
        MelLpLine: "array{k: 'head'|'shut'|'row'|'one'|'more', i: int, n: int, q: string}"
        # The search window between its ticks (MelLpv::$run, mel_lpv_search_open, online_search.php).
        # The view of the search so far in v, the poll of its replies (mel_lp_poll), more: the rows before "Ещё N" (-1: a new search).
        MelLpRun: 'array{sid: string, st: MelState, how: string, back: bool, path: string, key: string, fail: string, phase: string, search: MelLpSearch|null, v: MelLpView, poll: MelLpPoll, more: int}'
        # A choice of a source of the online list found on this Dune (lampac_sources of settings.json, mel_lp_srcs_ok, lampac.php): its path, name, shown;
        # not MelLpSource, a source of a search.
        MelLpChoice: 'array{path: string, name: string, on: bool}'
        # A config of AIOStreams made by the settings page (mel_aio_conf, common.php).
        MelConf: 'array{uuid: string, pass: string, manifest: string, tmdb: bool, set: list<string>|null, tpl: string|null}'
        # A JacRed to ask (mel_jacred_conf, mel_jacred_builtin_conf, common.php).
        MelJacred: 'array{base: string, host: string, key: string, key_url: string, builtin?: bool}'
        # A source profile (mel_profile_ok, source_profiles.php; v2): a config of Melange (Debrid, Торренты) with its keys, an own config, each with its JacRed, or Lampac.
        MelProfile: 'array{id: string, name: string, base: string, mode: string, tpl: string, jacred: string, jacred_own_url: string, jacred_own_key: string, conf: MelConf|null, rd_key: string, tb_key: string}|array{id: string, name: string, url: string, jacred: string, jacred_own_url: string, jacred_own_key: string}|array{id: string, name: string, lampac_url: string, lampac_token: string, lampac_as_lampa: bool, lampac_sources: list<MelLpChoice>}'
        # settings.json as read (mel_settings_read, common.php).
        MelSettings: '''
            array{
                source: 'made'|'own',
                manifest_url: string,
                rd_key: string,
                tb_key: string,
                jacred: string,
                jacred_own_url: string,
                jacred_own_key: string,
                aio_server: string,
                aio_own_url: string,
                aio_mode: string,
                aio_tpl: string,
                aio_tpl_p2p: string,
                tmdb_key: string,
                servers: list<MelServer>,
                ts_url: string,
                ts_user: string,
                ts_pass: string,
                ts_save: bool,
                markers: bool,
                markers_exact: bool,
                source_errors: bool,
                no_color_keys: bool,
                no_torrents: bool,
                cat_logo: bool,
                cat_card: bool|null,
                cat_rating: bool,
                cat_age: int|null,
                cat_rows: list<string>|null,
                lampac_url: string,
                lampac_token: string,
                lampac_as_lampa: bool,
                lampac_sources: list<MelLpChoice>,
                aio_confs: array<string, array<string, MelConf>>,
                src_profiles: bool,
                profiles: list<MelProfile>,
                src_main: string,
                saved_once: bool,
                mig_lost: list<string>
            }
        '''
        # Settings of the operation (Mel::$settings, mel_settings_load, main.php).
        MelOpSettings: '''
            array{
                base: string,
                jrs: list<MelJacred>,
                jrm: list<MelJacred>,
                servers: list<MelServer>,
                pw: list<string>,
                ts: string,
                ts_auth: string,
                ts_save: bool,
                markers: bool,
                markers_exact: bool,
                source_errors: bool,
                no_color_keys: bool,
                no_torrents: bool,
                aio: string,
                own: bool,
                hosts: array<string, string>,
                sort: string,
                sort_rev: bool,
                cat_rows: list<string>|null,
                cat_logo: bool,
                cat_rating: bool,
                cat_age: int|null,
                cat_card: bool,
                debrid_main: string,
                profiles: list<array{id: string, name: string, kind: string, ready: bool}>,
                prof: string,
                lp_prof: string,
                main: string,
                ready: bool,
                made: array{base: string, mode: string, conf: MelConf}|null,
                lp: string,
                lp_src: list<MelLpChoice>,
                lp_auth: array{token: string, lampa: bool, uid: string}
            }
        '''
        # Badges of a release (mel_badges, parse.php).
        MelBadges: 'array{res: string, src: string, vis: string, ai: bool, audio: list<string>, tags: list<string>}'
        # An audio track of the media info (mel_tracks, parse.php).
        MelTrack: 'array{lang: string, codec: string, ch: string, title: string}'
        # Tracks of a release by infoHash, from ffprobe of JacRed (mel_jacred,
        # jacred.php); a row (MelRow) is one too (mel_carry_tracks).
        MelTracks: 'array{tracks: list<MelTrack>, subs: list<string>}'
        # A file of a torrent in TorrServer, ids from 1 (mel_ts_files, torrserver.php).
        MelTsFile: 'array{id: int, path: string, size: float}'
        # An entry of the list of TorrServer, the section "На TorrServer" (mel_tsl_entry, ts_list.php).
        MelTsEntry: 'array{hash: string, title: string, raw_title: string, src: string, poster: string, category: string, ts: int, size: float, files: list<MelTsFile>|null, lampa: array<mixed>|null}'
        # An add-on that found the release (mel_addons, parse.php).
        MelAddon: 'array{addon: string, cached: bool}'
        # A copy of a row on one Debrid service (mel_row_copy_of, parse.php).
        MelCopy: 'array{svc: string, service: string, url: string, addon: string, addons: list<MelAddon>, raw: array<mixed>}'
        # What mel_row_merge compares of a row (mel_merge_key, parse.php).
        MelMergeKey: 'array{svc: string, hash: string, file: string, norm: string, idx: int, size: float, nk: string, whole: bool}'
        # The state of mel_row_merge over a reply (mel_merge_start, parse.php):
        # the rows by index, the index of rows by infoHash and by file name and size;
        # series: a reply of an episode.
        # untier: rows of the tier made of the main list by a copy of it.
        MelMerge: 'array{g: array<int, array{keys: list<MelMergeKey>, svcs: list<string>}>, hash: array<string, list<int>>, name: array<string, list<int>>, by_hash: int, by_name: int, untier: int, series: bool}'
        # The reason of a row of the tier (mel_tier_why, parse.php): the code of the server ('' not of
        # letters), the years of the release, of the title and the end of those of the title (null: none).
        MelTierWhy: 'array{code: string, ry: int|null, ty: int|null, te: int|null}'
        # A row of the stream list (mel_row, parse.php). names: until
        # mel_row_voices (voices_parse.php) puts voices in its place. copies,
        # copy: a file cached on several services (mel_row_merge, parse.php).
        # voice_langs: mel_row_langs of a row of a list (mel_list_state, main.php).
        # tier, tier_why: a row of the tier "Не подтверждены" and its reason (mel_row).
        MelRow: '''
            array{
                url: string,
                hash: string,
                cached: bool|null,
                seeders: int|null,
                service: string,
                resolution: string,
                badges: MelBadges,
                audio_full: string,
                tracks: list<MelTrack>,
                subs: list<string>,
                group: string,
                expr: string,
                network: string,
                pack: float,
                rate: float,
                rate_approx: bool,
                rate_src: string,
                quality: string,
                size: float,
                age: float|null,
                langs: list<string>,
                trackers: list<string>,
                addon: string,
                addons: list<MelAddon>,
                release_url: string,
                pf_seasons: list<int>|null,
                pf_episodes: list<int>,
                names?: array{string, string},
                voices?: MelVoices,
                voice_langs?: MelRowLangs,
                label: string,
                raw: array<mixed>,
                ord: int,
                copies?: list<MelCopy>,
                copy?: int,
                tier: bool,
                tier_why: MelTierWhy|null
            }
        '''
        # The card of play_action (mel_movie, main.php); own_card: of a list opened from the own card (aio_own_card of movie_str, mel_oc_watch); cin: the
        # runs of the numbering of Cinemeta of its series numbered on (mel_cin_valid), none for any other; titles: of the
        # episodes of a list from the own card, "s:e" => title (mel_titles_valid); tmdb: the digits of its TMDB (a series: of
        # tmdbtv_id), the releases of a card of no IMDb (mel_rel_id); of "Continue" of a copy on the disk that of the title of
        # the index (mel_lib_resume, mel_lib_resume_ep), the own card of its copies by it (mel_lib_win_card); rel_tmdb: an
        # IMDb the catalog matched, the releases by tmdb (mel_rel_id).
        MelMovie: '''
            array{
                series: bool,
                imdb: string,
                dune_id: string,
                title: string,
                native: string,
                year: string,
                poster: string,
                fanart: string,
                rate_imdb: string,
                seasons: array<int, int>,
                own_card?: bool,
                tmdb?: string,
                rel_tmdb?: bool,
                lpv_key?: string,
                cin: list<array{int, int, int}>,
                titles?: array<string, string>
            }
        '''
        # The state of a series by its history (mel_wh_series, history.php): the latest
        # episode record, "s:e" => array(pos, len, watched), the marks of the own card.
        MelWhSeries: 'array{stdClass|null, array<string, array{float, float, bool}>, array<string, int>}'
        # The episode to offer of a series by its history (mel_wh_pick, history.php).
        MelWhPick: 'array{s: int, e: int, hash: string, key: string, prof: string, kind: string, rec: string, why: string}'
        # The state of a card of the history (mel_pg_index, progress.php).
        MelPgEntry: 'array{w: stdClass|null, end: int, seen: bool, movie_mark: bool, series: MelWhSeries|null, ep: array{w: stdClass, seen: bool}|null}'
        # What the badges show of it (mel_pg_badge, progress.php).
        MelPgBadge: 'array{pos: float, len: float, watched: bool, s: int, e: int, all: bool, next: bool}'
        # A pair of a card of the Dune (mel_pg_links, links.php): its ids, or none / fail with a time.
        MelPgLink: 'array{imdb?: string, tmdb?: string, tmdbtv?: string, type?: string, seasons?: array<int, int>, soon?: array<string, string>, src?: string, on?: int, sq?: int, none?: int, fail?: int}'
        # The meta of a tile of the row "Continue" kept (mel_cpm_read, cp_meta.php): when written, its tile (null: a failure).
        MelCpmEntry: 'array{t: int, tile: MelCatTile|null}'
        # "Continue watching" of play_action (mel_resume, main.php; next:
        # mel_wh_resume_ep, history.php). mode: debrid, ts, lampac (hash: the key of an online record), ''; prof: wh_prof, the id of the profile of the start ('' none, v2).
        MelResume: 'array{hash: string, mode: string, s: int, e: int, pos: int, len: int, uid: string, prof: string, next: bool}'
        # recent_action_params of a linked vod_play (mel_recent_params, main.php): what "Continue watching" brings back
        # to play_action, kept in the records of the history - its keys and values never change.
        MelRecentParams: 'array{handler_id: string, control_id: string, sup_id: string, movie_id: string, sup_data: string, wh_release: string, wh_mode: string, wh_prof: string}'
        # Reasons of the error streams of a reply (mel_error_streams, main.php):
        # different lines up to MEL_ERRORS_MAX, more: different ones past them.
        MelErrors: 'array{lines: list<string>, more: int}'
        # A stream list (Mel::$state, mel_list_state, main.php), rows in the order
        # of sort (mel_sort_keys), reversed by sort_rev; rows may be empty from
        # 0.58.0 (a source profile with no streams, mel_gc_src); gc (sel, top:
        # the last cursor, of the lines of mel_gc_lv), gc_new, gc_prog, gc_cols,
        # tier_open (the group "Не подтверждены" unfolded): of view_gcomps.php.
        MelState: '''
            array{
                rid: string,
                movie: MelMovie,
                s: int,
                e: int,
                rows: list<MelRow>,
                lang: string,
                sort: string,
                sort_rev: bool,
                errors: MelErrors,
                gc?: array{int, int},
                gc_new?: bool,
                gc_prog?: MelProgress,
                gc_cols?: MelGcCols,
                tier_open?: bool,
                pack_only?: bool,
                pack_map?: array<int, array<int, int>>,
                lp?: MelLpView,
                lp_on?: bool,
                lp_only?: bool,
                lp_note?: string,
                prof: string,
                lp_prof: string
            }
        '''
        # The record of a GComps screen under an overlay (kit_ovl.php): its owner, action map, timer and sel_state.
        MelOvlScreen: 'array{owner: string, map: array<string, MelAction>, timer: array<string, int>|null, sel: string|null}'
        # The overlay of the last screen that opened one (MelOvl::$st, kit_ovl.php): the record of the screen, shown or
        # not; the side panel open, the choices of its check lists left after its close (by the id of the item of their
        # submenu, '' the panel itself); the window of the copies of the own card open (lw).
        MelOvlState: 'array{scr: MelOvlScreen, open: bool, kp?: MelKp, kp_done?: array<string, MelKpChoice>, dlg?: MelDlg, wt?: MelWait, lw?: MelLibWin}'
        # The window of the copies on the disk over the own card (W2, MelOvl::$st['lw'], view_card_libwin.php): copies, its
        # lines (the best first); at, the line of the cursor; mode, first (the first "Смотреть") or menu (MENU "Копия на
        # диске…"); s, e, the episode (-1 of a movie); cur, the cid of the copy "· сейчас" ('' none); top, the first line
        # shown; share, the progress of the line "сейчас" (0 none: no bar).
        MelLibWin: "array{copies: list<MelLibCopy>, at: int, mode: 'first'|'menu', s: int, e: int, cur: string, top: int, share: float}"
        # The window of the copies the first tick of the screen of an own card opens over it (MelOcCard lw_auto: "Continue"
        # of the native with a copy to choose, mel_lib_win_card; its mode first): its copies (2+, the best first), s, e the
        # episode (-1 of a movie).
        MelLibAuto: 'array{copies: list<MelLibCopy>, s: int, e: int}'
        # A button of the own dialog or wait (kit_dlg.php, mel_dlg_buttons): its id, label, icon, the action after the
        # close (null none), RETURN presses it (cancel, of a wait).
        MelDlgButton: 'array{id: string, label: string, icon: string, act: MelAction|null, cancel: bool}'
        # The own dialog open (kit_dlg.php): its icon, tone, title, text, buttons, the one in focus, the action of RETURN.
        MelDlg: 'array{icon: string, tone: string, title: string, text: string, buttons: list<MelDlgButton>, cur: int, cancel: MelAction|null}'
        # The wait open (kit_dlg.php): the view of its window (live, share and the seconds of the live line, elapsed its
        # start), the action of RETURN with no cancel button, the function of its ticks and its data, the open time, the
        # period of its ticks (ms), late (null: none or passed) and its time, the text of late that stays.
        MelWait: 'array{icon: string, tone: string, title: string, text: string, live: string, share: float|null, elapsed: string, buttons: list<MelDlgButton>, cur: int, cancel: MelAction|null, tick: string, data: mixed, t0: int, sec: int, ms: int, late: array<string, mixed>|null, late_at: int, late_text: string|null}'
        # The look of an error or a wait screen (kit_scr.php, MelKit::error_screen): the card background of the title or ''
        # (that of Melange), the one while it loads, the logo baked into it, the line under «Melange» of the head.
        MelKsLook: 'array{bg: string, nl: string|null, logo: bool, sub: string}'
        # An error or a wait screen kept (MelKs::$scr): its look, the detail line of an error, the error (as the own dialog)
        # or the wait, its end (null: live).
        MelKsScreen: 'array{look: MelKsLook, detail: string, dlg: MelDlg|null, wt: MelWait|null, end: string|null}'
        # The side panel open (kit_panel.php): its panels, a submenu over its panel last; the choices of the check lists
        # of submenus left (by the id of their item) and the act of «Готово» of the last one.
        MelKp: 'array{stack: non-empty-list<MelKpFrame>, done: array<string, MelKpChoice>, act: MelAction|null}'
        # A panel of MelKp: its description, its items by id, the ids of a menu by group, the cursor, the first line of
        # the list shown; of a check list the checks, the order and a line taken.
        MelKpFrame: 'array{desc: MelKpDesc|MelKpSubDesc, its: array<string, MelKpItem|MelKpLeaf|MelKpCheck>, groups: list<list<string>>, cur: int, top: int, on: array<string, bool>, order: list<string>, move: bool}'
        # The choice of a check list at its close (mel_kp_done): the ids checked and all the ids, in the order of the lines.
        MelKpChoice: 'array{on: list<string>, order: list<string>}'
        # The description of a panel by its screen (kit_panel.php): a menu (groups) or a check list (items).
        MelKpDesc: '''
            array{
                title?: string,
                sub?: string,
                dim?: string,
                note?: string,
                groups?: list<list<MelKpItem>>,
                all?: string,
                items?: list<MelKpCheck>,
                move?: string,
                done?: array{label: string, count?: string, act?: MelAction}
            }
        '''
        # The description of a submenu (MelKpItem menu): as MelKpDesc, its items with no submenu of their own.
        MelKpSubDesc: '''
            array{
                title?: string,
                sub?: string,
                dim?: string,
                note?: string,
                groups?: list<list<MelKpLeaf>>,
                all?: string,
                items?: list<MelKpCheck>,
                move?: string,
                done?: array{label: string, count?: string, act?: MelAction}
            }
        '''
        # An item of a menu of the side panel: menu, the description of its submenu, or act, its action.
        MelKpItem: 'array{id: string, label: string, icon?: string, detail?: string, value?: string, picked?: bool, way?: string, menu?: MelKpSubDesc, act?: MelAction}'
        # An item of a submenu: no submenu of its own.
        MelKpLeaf: 'array{id: string, label: string, icon?: string, detail?: string, value?: string, picked?: bool, way?: string, act?: MelAction}'
        # An item of a check list of the side panel.
        MelKpCheck: 'array{id: string, label: string, count?: string, on?: bool}'
        # The row and the map of the last start through TorrServer (Mel::$ts_pack, torrserver.php).
        MelTsPack: 'array{key: string, hash: string, row: MelRow, map: array<int, array<int, int>>}'
        # Of the shell: a GuiAction (handler_string_id, data, params, ...),
        # its fields by the handler (mel_error, mel_input, main.php).
        MelAction: 'array<string, mixed>'
        # The stream check of a URL, by its redirect (mel_pre_class,
        # mel_precheck, playback.php): the CDN, a placeholder (a video of the
        # add-on, the slate of ElfHosted, a small 200 video of Comet, an
        # archive) with the key and detail of its message (detail only with
        # err_pre_placeholder) and a note for the log, else unclear.
        MelPrecheck: '''
            array{class: 'stream', url: string, host: string}
            |array{class: 'placeholder', key: string, detail: string, note: string}
            |array{class: 'unclear', why: string}
        '''
        # The card of a playlist with lazy episodes (Mel::$movies,
        # mel_movie_save, mel_movie_load, playback.php).
        MelLazyMovie: 'array{movie: MelMovie, lang: string}'
        # What plays (Mel::$playing, mel_playing, playback.php): rid of the
        # list screen under the player ('' none), the list state, its row.
        MelPlaying: 'array{from: string, st: MelState, sel: int}'
        # The dialog of a start refused by its Debrid with "Via <the other one>" or "The same
        # episode from another release" (Mel::$alt, mel_pre_failed, playback.php): the list
        # state of the start, its row, the position, under the player or not, rid of the
        # screen under the player to note (mel_playing; '' none), the services of the row
        # refused on this start, the rows refused on it, the row offered (mel_pre_twin, -1 none).
        MelAlt: 'array{st: MelState, i: int, pos: int, lazy: bool, from: string, tried: list<string>, rows: list<int>, twin: int}'
        # The service chosen by "Via <service>" for this viewing (Mel::$via, mel_pre_via).
        MelVia: 'array{k: string, hash: string, svc: string}'
        # Params of the window of TorrServer in the player (mel_tsi_params, ts_info.php).
        MelTsiParams: 'array{h: string, n: string, l: string, e: string}'
        # A stream request (mel_fetch, main.php).
        MelFetch: 'array{rows: list<MelRow>, errors: MelErrors}|array{error: string, detail: string, errors?: MelErrors}'
        # Progress of the releases of a list (mel_wh_progress, history.php):
        # the tail of our uid of the history after "aio:<dune id>:<s>:<e>:" =>
        # share in (0, 1]. Our uids end in an infoHash (40 hex: a string key);
        # a record of the history not written by us may end in a decimal
        # number, which PHP makes an int key - no infoHash matches it.
        MelProgress: 'array<int|string, float>'
        # Words of the list screen (mel_gc_text, view_gcomps.php).
        MelGcText: '''
            array{
                lang: string, page: string, pack: string, group: string, source: string,
                cached: string, cached_in: string, cached_and: string, download: string, unknown: string, p2p: string,
                video: string, audio: string, voices: string, subs: string, langs: string,
                trackers: string, addon: string, flip: string, actions: string, details: string,
                sort_aio: string, sort_seeds: string, sort_cached: string, sort_size: string, sort_date: string, errors: string,
                tier: string, tier_card: string, tier_show: string, tier_hide: string, check: string
            }
        '''
        # The lines of the list screen over its rows (mel_gc_lv, view_gcomps.php): rows of the tier (first in the
        # rows), the group of them unfolded, rows, lines.
        MelGcLv: 'array{t: int, o: bool, n: int, l: int}'
        # Columns of the list (mel_gc_cols, view_gcomps.php): x and width;
        # an empty column is not there.
        MelGcCols: '''
            array{
                icon: array{int, int},
                res?: array{int, int},
                src?: array{int, int},
                vis?: array{int, int},
                audio?: array{int, int},
                size?: array{int, int},
                langs?: array{int, int},
                tracker?: array{int, int}
            }
        '''
        # GComps of the shell (gcomps.php). GCompAlignDef: its non-zero
        # fields only (mel_gc_align).
        MelGcAlign: 'array<string, bool|int|string>'
        # GCompGeometryDef (mel_gc_geom).
        MelGcGeom: 'array{w: int, h: int, align_def?: MelGcAlign}'
        # GComponentDef of a label, rect, picture or panel (mel_gc_ttf,
        # mel_gc_rect, mel_gc_image, mel_gc_panel); specific_def by the kind.
        MelGcComp: '''
            array{
                id?: string|null,
                geom_def: MelGcGeom,
                margins_def?: null,
                options?: int,
                kind: string,
                specific_def: array<string, mixed>
            }
        '''
        # An item of the kit (kit.php): its components and its visible edges;
        # a text also its width, size, face, lines, baseline and step.
        MelKitItem: '''
            array{
                kind: string,
                defs: list<MelGcComp>,
                x0: int,
                x1: int,
                top: int,
                bottom: int,
                mid: int|float,
                cy: int|float,
                caps: bool,
                ids: list<string>,
                w?: int,
                px?: int,
                face?: string,
                lines?: list<string>,
                base?: int,
                step?: int
            }
        '''
        # A line of the side panel (MelKit::panel_row): its group id (in MelKit::panel), label, state and the rest.
        MelKitPanelRow: 'array{id?: string, label: string, state?: string, icon?: string, check?: bool, detail?: string, value?: string, chevron?: bool, count?: string, picked?: bool, way?: string}'
        # The view of the side panel (MelKit::panel): its lines by group, the first line of the list shown, «Готово».
        MelKitPanel: 'array{id?: string, title: string, back?: bool, sub?: string, dim?: string, x?: int, groups: list<list<MelKitPanelRow>>, top?: int, hint?: string, done?: array{label: string, count: string, state: string}|null, note?: string}'
        # ChangeGCompDef of change_gcomps (mel_gc_change).
        MelGcChange: '''
            array{
                id: string,
                geom_def: MelGcGeom|null,
                props: null,
                view_position: null,
                selected: null,
                children: list<MelGcComp>|null,
                transition: string
            }
        '''
        # A column of page 1 of the details screen (mel_info_col, view_info.php):
        # its x, the y of the next field, its bottom, the x of values, its
        # components so far (mel_info_put adds the fields), how many tracks
        # it does not show whole (mel_info_col_tracks; else 0).
        MelInfoCol: 'array{x: int, y: int, end: int, lw: int, d: list<MelGcComp>, hid: int}'
        # Subtitles of page 1 (mel_info_subs, view_info.php): the label with
        # the count of all, the tracks wrapped (else []), the languages joined
        # by ", " (else ''), the count of all, the lines the middle column
        # gives them at most.
        MelInfoSubs: 'array{label: string, st: list<list<string>>, codes: string, n: int, lines: int}'
        # The middle column of page 1 before its layout (mel_info_mid,
        # view_info.php): the column with its head, the voices, their first
        # group alone, the label of the audio, its tracks wrapped, their count.
        MelInfoMid: 'array{col: MelInfoCol, voices: string, alone: bool, alabel: string, audio: list<list<string>>, n_audio: int}'
        # Voices of one release name (mel_voices_parse, voices_parse.php):
        # type ids (dub, mvo, dvo, avo) in the order of the name, studios
        # shown, orig '' | 'orig' | 'jap', the name without JacRed's tails,
        # keys: studio => its key of voices.php, stype: studio => its type id;
        # ru: 'int' | 'ext' of "RUS(int)", "RUS(ext)", '' none; ru_type: a type
        # of a Russian voice; ru_subs: Russian subtitles, ukr: a Ukrainian mark
        # (mel_voices_ru_marks); loose: studios not of its voices, ru_hint: a
        # Russian mark (mel_row_langs).
        MelVoicesName: '''
            array{
                types: list<string>,
                studios: list<string>,
                orig: string,
                subs: bool,
                name: string,
                keys: array<string, string>,
                stype: array<string, string>,
                ru: string,
                ru_type: bool,
                ru_subs: bool,
                ukr: bool,
                loose: array<string, true>,
                ru_hint: bool
            }
        '''
        # Voices of a row from its names (mel_voices, voices_parse.php); ua:
        # "(УКР.)" in a name (mel_row_voices); ru, ru_type, ru_subs, ukr,
        # ru_hint: as of MelVoicesName, of all the names; loose: studios no name
        # has in its voices.
        MelVoices: '''
            array{
                types: list<string>,
                studios: list<string>,
                orig: string,
                subs: bool,
                stype: array<string, string>,
                ru?: string,
                ru_type?: bool,
                ru_subs?: bool,
                ukr?: bool,
                loose?: array<string, true>,
                ru_hint?: bool,
                ua?: true
            }
        '''
        # What the "Voices" field shows (mel_row_voices_struct,
        # voices_parse.php): groups: type id (dub, mvo, dvo, avo) => its
        # studios, types without studios, studios without a type; ru: of the names.
        MelVoicesStruct: '''
            array{
                groups: array<string, list<string>>,
                types: list<string>,
                studios: list<string>,
                orig: string,
                subs: bool,
                ru: string
            }
        '''
        # Languages of the voices of a row (mel_row_langs, voices_parse.php):
        # confirmed, Russian first; guessed.
        MelRowLangs: 'array{ok: list<string>, q: list<string>}'
        # Tokens of a name (mel_voices_tokens, voices_parse.php), by word from
        # 0: as written, lower case, the joint to the next, the separator after
        # it, its part between "|", its depth in brackets, inside the leading
        # "[...]"; then where each "|" is, from 1.
        MelVoicesTokens: '''
            array{
                list<string>,
                list<string>,
                list<string>,
                list<string>,
                list<int>,
                list<int>,
                list<bool>,
                array<int, int>
            }
        '''
        # What a word of a name is (mel_voices_classes, voices_parse.php):
        # kind and id; a studio: its name shown and its key.
        MelVoicesClass: '''
            array{'studio', string, string}
            |array{'in'|'n', ''}
            |array{'code', string}
            |MelVoicesWord
        '''
        # A word by itself (mel_voices_word, voices_parse.php): kind and id.
        MelVoicesWord: "array{'type'|'orig'|'subs', string}"
        # A side of brackets of a track title (mel_voices_side, voices_parse.php).
        MelVoicesSide: 'array{studios: list<string>, n: int, other: bool}'
        # The meta of a title for its own card (mel_cm_parse, card_meta.php).
        MelCardMeta: 'array{type: string, id: string, imdb: string, tile: MelCatTile|null, original: string, description: string, tagline: string, released: string, studios: list<string>, networks: list<string>, status: string, countries: list<string>, cast: list<MelCardCredit>, directors: list<MelCardCredit>, writers: list<MelCardCredit>, creators: list<MelCardCredit>, collection: array{id: string, name: string}, seasons: array<int, list<MelCardEp>>, season_numbers: array<int, int>, trailer: bool, by_cin: bool, cin: list<array{int, int, int}>, rel_tmdb: bool}'
        # A card of the own card screen in memory (MelOc::$cards, view_card.php); lw_auto - the window of the copies its
        # first tick opens (mel_lib_win_card, mel_oc_tick).
        MelOcCard: 'array{tile: MelCatTile, meta: MelCardMeta|null, imdb: string, dune: string, lang: string, ui: string, pos: MelOcPos, n: int, posters: MelCmPosters, nav?: MelOcNav, played?: bool, stopped?: bool, lw_auto?: MelLibAuto}'
        # The rows of posters of an own card (mel_cm_posters, card_more.php): similar titles, the movies of a franchise; what is
        # left to ask (wait), how each went (st), the time of the asks (ms).
        MelCmPosters: 'array{sim: list<MelCatTile>, parts: list<MelCatTile>, cur: int, coll: string, wait: list<string>, st: array<string, string>, ms: int}'
        # The copies on the disk of an own card (mel_oc_lib, view_card_lib.php): the keys of MelOcNav, and the files of the episodes for the history.
        MelOcLib: 'array{lib: list<MelLibCopy>, hid: string, lib_eps: array<string, list<MelLibCopy>>, lib_y: string, lib_cur: array<string, string>, fix: array<string, array{int, int}|string>}'
        # A place of the focus on the own card, in MelOcCard and in sel_state (mel_oc_pos, view_card.php).
        MelOcPos: 'array{z: string, b: int, p: int, s: int, e: int, r: array<string, int>}'
        # What the keys of the own card need of its layout (view_card.php).
        MelOcNav: 'array{kind: string, btns: list<array{string, string, string, int}>, btn_y: int, stops: list<int>, clips: list<int>, tops: list<int>, h: int, off: int, zones: list<string>, tabs: MelOcTabs, ep: MelOcEp|null, prog: array<string, array{float, float, bool}>, rows: array<int, string>, strips: array<string, MelOcStrip>, tw: int, first: list<array<string, mixed>>, over_y: int, lib: list<MelLibCopy>, hid: string, lib_eps: array<string, list<MelLibCopy>>, lib_y: string, lib_cur: array<string, string>}'
        # The own card laid out (mel_oc_layout, view_card.php).
        MelOcLayout: 'array{kind: string, btns: list<array{string, string, string, int}>, btn_y: int, stops: list<int>, clips: list<int>, tops: list<int>, h: int, off: int, zones: list<string>, tabs: MelOcTabs, ep: MelOcEp|null, prog: array<string, array{float, float, bool}>, rows: array<int, string>, strips: array<string, MelOcStrip>, tw: int, first: list<array<string, mixed>>, over_y: int, down: list<array<string, mixed>>, lib: list<MelLibCopy>, hid: string, lib_eps: array<string, list<MelLibCopy>>, lib_y: string, lib_cur: array<string, string>}'
        # A folder of the media library of the Dune (mel_lib_folders, library.php).
        MelLibFolder: 'array{id: string, source_id: string, path: string, caption: string}'
        # A network folder of the shell, no login or password (mel_lib_network_folders, library.php).
        MelLibNf: 'array{id: string, name: string, type: string, server: string, dir: string}'
        # A share the shell mounted, no login or password (mel_lib_mounts, library.php).
        MelLibMount: 'array{path: string, type: string, server: string, server_ipaddr: string, dir: string, status: string}'
        # A storage of storage_list.xml - USB, the disk of the bay (mel_lib_storages, library.php): path - where it is mounted ('' not connected), kind - its kind, [a-z0-9_] only ('?' none).
        MelLibStorage: 'array{path: string, kind: string}'
        # A movie or episode file of the index of the media library (mel_lib_folder_index, mel_lib_eps_fix, library.php); tags: the media tags of the indexer, upper case, each once (mel_lib_tags); res: the resolution by the tags, else by the name (mel_lib_res); s, e: the season and the episode (-1 of a movie); dir: the folder of the file in the folder of the library ('' at its root); hrp: of a movie file of a disc folder, its main stream in it (mel_lib_hrp; none else).
        MelLibFile: 'array{folder: string, path: string, mid: string, hash: string, size: float, tags: list<string>, res: string, s: int, e: int, dir: string, hrp?: string}'
        # An episode file as the index has it, before the rules of the numbers (mel_lib_folder_index, mel_lib_eps_fix, library.php): the fields of MelLibEpRec, dir (as in MelLibFile), mc - match_confirmed of the index.
        MelLibEpIn: 'array{folder: string, path: string, hash: string, size: float, tg: string, s: int, e: int, dir: string, mc: bool}'
        # An episode file kept (MelLib::$eps, library.php): the fields of a MelLibFile but mid (the key of MelLib::$eps), tags, res and dir (mel_lib_ep_file gets them); tg - the tags as the index has them.
        MelLibEpRec: 'array{folder: string, path: string, hash: string, size: float, tg: string, s: int, e: int}'
        # A copy of a movie or an episode on a mounted share or a connected storage (mel_lib_copies, mel_lib_ep_copies, library.php): the fields of its file (MelLibFile), url - the path checked (mel_lib_here) and of its id (cid), played by vod_play when the copy has no shell_url (of a disc folder its main stream, hrp), shell_url - of a disc folder the URL of it the shell plays it by (mel_lib_shell_url, launch_media_url), mnt - where the source of its folder is mounted (url starts with it), srv - the server of that mount (server_ipaddr, else its name in lower case; the source_id of a storage, of sdcard://), key - lib-<12 hex> (one of mirrors), cid - cp-<12 hex> of url (mel_lib_cid), caption - of its folder (mel_lib_tails, sources.php).
        MelLibCopy: 'array{folder: string, path: string, mid: string, hash: string, size: float, tags: list<string>, res: string, s: int, e: int, dir: string, hrp?: string, shell_url?: string, url: string, mnt: string, srv: string, key: string, cid: string, caption: string}'
        # The data of a copy for its lines (mel_lib_copy_parts, view_card_lib.php): quiet - the ids of the plates b2 without the audio, ids - all of them, ch - the id of the plate b2 of its best channels (ch-71; '' none, or a layout with no plate), size - as text ('' none).
        MelLibParts: 'array{quiet: list<string>, ids: list<string>, ch: string, size: string}'
        # A title whose files are looked for in the media library (mel_lib_mid, library.php): its card of the Dune, IMDb, TMDB (of a series its TMDB of series), type (movie, series), year, names (of the tile, English, original).
        MelLibTitle: 'array{dune: string, imdb: string, tmdb: string, type: string, year: string, names: list<string>}'
        # The copy the check before a start found there (mel_lib_start, mel_lib_play, playback_lib.php): at - the place in s, i of n - which copy, for the log, dur - the length of its MKV (of an episode), 0 unknown.
        MelLibHere: 'array{copy: MelLibCopy, at: int, i: int, n: int, dur: float}'
        # What the check of the copies before a start gives (mel_lib_start, playback_lib.php): the copy there (MelLibHere); the copies left to choose of, 2+; none left - gone 'no' or 'slow'.
        MelLibGo: 'MelLibHere|array{pick: list<MelLibCopy>}|array{gone: string}'
        # The episode of a start of a copy on the disk (mel_lib_play, playback_lib.php): y - the series of the index, q, e - the episode (the season as asked), eps - the copies of the series "q:e" => copies (mel_lib_ep_copies).
        MelLibEp: 'array{y: string, q: int, e: int, eps: array<string, list<MelLibCopy>>}'
        # The latest record of a copy on the disk of a card (MelWh::$lib, history.php): key, pos and len in s, its end.
        MelLibRec: 'array{key: string, pos: float, len: float, end: int}'
        # A strip of a row under a frame of the focus (view_card_row.php).
        MelOcStrip: 'array{n: int, nc: int, w: int, h: int, cw: int, ch: int, step: int, div: int, vis: int, lead: int, x: int, y: int, id: string}'
        # The tabs of the seasons of a series card (mel_oc_tabs_layout, view_card_series.php).
        MelOcTabs: 'array{list: list<array{int, string, int, int}>, x: int, w: int, all: int, word: int, cx: int}'
        # The episode a series card offers (mel_oc_pick, view_card_series.php).
        MelOcEp: 'array{q: int, e: int, s: int, hash: string, key: string, prof: string, kind: string}'
        # A person of the own card: an actor, a director, a writer, a creator (mel_cm_people, card_meta.php).
        MelCardCredit: 'array{name: string, role: string, photo: string, tmdb: string}'
        # A person of the own card asked by ENTER (mel_cm_person_parse, card_more.php).
        MelCmPerson: 'array{id: string, name: string, photo: string, born: string, died: string, place: string, bio: string, pars: list<array{string, string}>, bio_en: bool, known_for: string, works: list<MelCmWork>}'
        # A work of a person (mel_cm_person_parse, card_more.php).
        MelCmWork: 'array{tile: MelCatTile, role: string, types: list<string>, eps: int}'
        # A person of the page of a person in memory (MelPp::$people, view_person.php).
        MelPpEntry: 'array{name: string, photo: string, job: string, lang: string, ui: string, pos: MelPpPos, err: string, tries: int, drawn: list<string>|null}'
        # A place of the focus on the page of a person, in MelPpEntry and in sel_state (mel_pp_pos, view_person.php).
        MelPpPos: 'array{z: string, p: int, k: int}'
        # The page of a person laid out (mel_pp_layout, view_person.php).
        MelPpLayout: 'array{state: string, strip: MelOcStrip, bio: list<string>, pages: list<list<array{string, bool, int}>>}'
        # The fields of a link of the public action open, '' for one not given (mel_dl_parse, deep_link.php).
        MelDlLink: 'array{to: string, type: string, imdb: string, tmdb: string, s: string, e: string, tab: string, n: string, q: string, src: string}'
        # An episode of the own card (mel_cm_eps, card_meta.php).
        MelCardEp: 'array{s: int, e: int, title: string, date: string, img: string, min: int, soon: bool, desc: string}'
