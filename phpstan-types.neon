# PHPStan typeAliases syntax; the config of the check is not published in this repository.
# Shapes of the main arrays of plugin/melange, for the PHPDoc of its code
# (@param AioRow $r ...). The code is PHP 5.3, so the types live in comments
# only and are checked by PHPStan; this file is not in the zip. The meaning of
# each key is in the comment of the function that makes the array.
parameters:
    typeAliases:
        # A row of the catalog (aio_cat_row, catalog.php); q: the query of a search (aio_cat_search_row), sid: its id (aio_catv_search_run).
        AioCatRow: 'array{key: string, type: string, id: string, name: string, genre: string, home: bool, group: string, q?: string, sid?: string}'
        # A tile of a row (aio_cat_tile, catalog.php).
        AioCatTile: 'array{id: string, imdb_id: string, _tmdbId: string, type: string, name: string, year: string, imdbRating: string, description: string, genres: list<string>, poster: string, background: string, country: string, runtime: string, age: string, cast: list<string>, englishTitle: string, kpRating: string, kpVotes: int, kpId: string, logo: string, logoLang: string}'
        # A listing of a row (aio_cat_row_state, catalog.php).
        AioCatState: 'array{row: AioCatRow, t0: int, skip: int, end: string, seen: array<string, bool>}'
        # A result of a listing or a search (aio_cat_more, catalog.php).
        AioCatResult: 'array{tiles: list<AioCatTile>, reset: bool, end: bool, stale: bool, err: string}'
        # The rows of the manifest (aio_cat_manifest, catalog.php).
        AioCatRows: 'array{rows: list<AioCatRow>, stale: bool, err: string}'
        # The copy of a page in the cache (aio_cat_page_cached, catalog.php).
        AioCatCached: 'array{t: int, n: int, data: list<AioCatTile>}'
        # A listing on the screen, tiles by their id (aio_catv_list, view_catalog.php); restored: of a copy, not in memory before (aio_catv_list_restore).
        AioCatList: 'array{st: AioCatState, tiles: array<int|string, AioCatTile>, stale: bool, restored?: bool}'
        # A server of "Download to server" (aio_server_conf, common.php).
        AioServer: 'array{name: string, url: string, user: string, pass: string, category: string, tags: string, cache: string, type: string}'
        # A reply of TorrServer (aio_ts_call, net.php).
        AioTsReply: 'array{code: int, body: string, err: string, errno: int}'
        # A reply of the Transmission RPC (aio_trm_call, net.php).
        AioTrmReply: 'array{code: int, body: string, err: string, errno: int, sid: bool}'
        # A config of AIOStreams made by the settings page (aio_aio_conf, common.php).
        AioConf: 'array{uuid: string, pass: string, manifest: string, tmdb: bool, set: list<string>|null, tpl: string|null}'
        # A JacRed to ask (aio_jacred_conf, aio_jacred_builtin_conf, common.php).
        AioJacred: 'array{base: string, host: string, key: string, key_url: string, builtin?: bool}'
        # A source profile (aio_profile_ok, source_profiles.php): a config of Melange or an own config, each with its JacRed.
        AioProfile: 'array{name: string, base: string, mode: string, tpl: string, jacred: string, jacred_own_url: string, jacred_own_key: string, conf: AioConf|null}|array{name: string, url: string, jacred: string, jacred_own_url: string, jacred_own_key: string}'
        # settings.json as read (aio_settings_read, common.php).
        AioSettings: '''
            array{
                source: 'made'|'own',
                manifest_url: string,
                rd_key: string,
                tb_key: string,
                jacred: string,
                jacred_own_url: string,
                jacred_own_key: string,
                aio_server: string,
                aio_own_url: string,
                aio_mode: string,
                aio_tpl: string,
                aio_tpl_p2p: string,
                tmdb_key: string,
                servers: list<AioServer>,
                ts_url: string,
                ts_user: string,
                ts_pass: string,
                ts_save: bool,
                markers: bool,
                markers_exact: bool,
                source_errors: bool,
                no_torrents: bool,
                cat_logo: bool,
                cat_rating: bool,
                cat_rows: list<string>|null,
                aio_confs: array<string, array<string, AioConf>>,
                src_profiles: bool,
                profiles: list<AioProfile>,
                saved_once: bool
            }
        '''
        # Settings of the operation (Aio::$settings, aio_settings_load, main.php).
        AioOpSettings: '''
            array{
                base: string,
                jrs: list<AioJacred>,
                jrm: list<AioJacred>,
                servers: list<AioServer>,
                pw: list<string>,
                ts: string,
                ts_auth: string,
                ts_save: bool,
                markers: bool,
                markers_exact: bool,
                source_errors: bool,
                no_torrents: bool,
                aio: string,
                own: bool,
                hosts: array<string, string>,
                sort: string,
                sort_rev: bool,
                cat_rows: list<string>|null,
                cat_logo: bool,
                cat_rating: bool,
                debrid_main: string,
                profiles: array<int, array{name: string, now: bool}>
            }
        '''
        # Badges of a release (aio_badges, parse.php).
        AioBadges: 'array{res: string, src: string, vis: string, ai: bool, audio: list<string>, tags: list<string>}'
        # An audio track of the media info (aio_tracks, parse.php).
        AioTrack: 'array{lang: string, codec: string, ch: string, title: string}'
        # Tracks of a release by infoHash, from ffprobe of JacRed (aio_jacred,
        # jacred.php); a row (AioRow) is one too (aio_carry_tracks).
        AioTracks: 'array{tracks: list<AioTrack>, subs: list<string>}'
        # A file of a torrent in TorrServer, ids from 1 (aio_ts_files, torrserver.php).
        AioTsFile: 'array{id: int, path: string, size: float}'
        # An add-on that found the release (aio_addons, parse.php).
        AioAddon: 'array{addon: string, cached: bool}'
        # A copy of a row on one Debrid service (aio_row_copy_of, parse.php).
        AioCopy: 'array{svc: string, service: string, url: string, addon: string, addons: list<AioAddon>, raw: array<mixed>}'
        # What aio_row_merge compares of a row (aio_merge_key, parse.php).
        AioMergeKey: 'array{svc: string, hash: string, file: string, idx: int, size: float, nk: string}'
        # The state of aio_row_merge over a reply (aio_merge_start, parse.php):
        # the rows by index, the index of rows by infoHash and by file name and size.
        AioMerge: 'array{g: array<int, array{keys: list<AioMergeKey>, svcs: list<string>}>, hash: array<string, list<int>>, name: array<string, list<int>>, by_hash: int, by_name: int}'
        # A row of the stream list (aio_row, parse.php). names: until
        # aio_row_voices (voices_parse.php) puts voices in its place. copies,
        # copy: a file cached on several services (aio_row_merge, parse.php).
        AioRow: '''
            array{
                url: string,
                hash: string,
                cached: bool|null,
                seeders: int|null,
                service: string,
                resolution: string,
                badges: AioBadges,
                audio_full: string,
                tracks: list<AioTrack>,
                subs: list<string>,
                group: string,
                expr: string,
                network: string,
                pack: float,
                rate: float,
                rate_approx: bool,
                rate_src: string,
                quality: string,
                size: float,
                age: float|null,
                langs: list<string>,
                trackers: list<string>,
                addon: string,
                addons: list<AioAddon>,
                release_url: string,
                pf_seasons: list<int>|null,
                pf_episodes: list<int>,
                names?: array{string, string},
                voices?: AioVoices,
                label: string,
                raw: array<mixed>,
                ord: int,
                copies?: list<AioCopy>,
                copy?: int
            }
        '''
        # The card of play_action (aio_movie, main.php); own_card: of a list opened from the own card (aio_oc_watch).
        AioMovie: '''
            array{
                series: bool,
                imdb: string,
                dune_id: string,
                title: string,
                native: string,
                year: string,
                poster: string,
                fanart: string,
                rate_imdb: string,
                desc: string,
                seasons: array<int, int>,
                own_card?: bool
            }
        '''
        # The episode to offer of a series by its history (aio_wh_pick, history.php).
        AioWhPick: 'array{s: int, e: int, hash: string, kind: string, rec: string, why: string}'
        # "Continue watching" of play_action (aio_resume, main.php; next:
        # aio_wh_resume_ep, history.php).
        AioResume: 'array{hash: string, mode: string, s: int, e: int, pos: int, len: int, uid: string, next: bool}'
        # Reasons of the error streams of a reply (aio_error_streams, main.php):
        # different lines up to AIO_ERRORS_MAX, more: different ones past them.
        AioErrors: 'array{lines: list<string>, more: int}'
        # A stream list (Aio::$state, aio_list_state, main.php), rows in the order
        # of sort (aio_sort_keys), reversed by sort_rev; rows may be empty from
        # 0.58.0 (a source profile with no streams, aio_gc_src); gc (sel, top:
        # the last cursor), gc_new, gc_prog: of view_gcomps.php.
        AioState: '''
            array{
                rid: string,
                movie: AioMovie,
                s: int,
                e: int,
                rows: list<AioRow>,
                lang: string,
                sort: string,
                sort_rev: bool,
                errors: AioErrors,
                gc?: array{int, int},
                gc_new?: bool,
                gc_prog?: AioProgress,
                pack_only?: bool,
                pack_map?: array<int, array<int, int>>
            }
        '''
        # The row and the map of the last start through TorrServer (Aio::$ts_pack, torrserver.php).
        AioTsPack: 'array{key: string, hash: string, row: AioRow, map: array<int, array<int, int>>}'
        # Of the shell: a GuiAction (handler_string_id, data, params, ...),
        # its fields by the handler (aio_error, aio_input, main.php).
        AioAction: 'array<string, mixed>'
        # The stream check of a URL, by its redirect (aio_pre_class,
        # aio_precheck, playback.php): the CDN, a placeholder (a video of the
        # add-on, the slate of ElfHosted, a small 200 video of Comet, an
        # archive) with the key and detail of its message (detail only with
        # err_pre_placeholder) and a note for the log, else unclear.
        AioPrecheck: '''
            array{class: 'stream', url: string, host: string}
            |array{class: 'placeholder', key: string, detail: string, note: string}
            |array{class: 'unclear', why: string}
        '''
        # The card of a playlist with lazy episodes (Aio::$movies,
        # aio_movie_save, aio_movie_load, playback.php).
        AioLazyMovie: 'array{movie: AioMovie, lang: string}'
        # What plays (Aio::$playing, aio_playing, playback.php): rid of the
        # list screen under the player ('' none), the list state, its row.
        AioPlaying: 'array{from: string, st: AioState, sel: int}'
        # The dialog of a copy refused by its Debrid with "Via <the other one>" (Aio::$alt,
        # aio_pre_failed, playback.php): the list state of the start, its row, the
        # position, under the player or not, rid of the screen under the player to
        # note (aio_playing; '' none), the services refused on this start.
        AioAlt: 'array{st: AioState, i: int, pos: int, lazy: bool, from: string, tried: list<string>}'
        # The service chosen by "Via <service>" for this viewing (Aio::$via, aio_pre_via).
        AioVia: 'array{k: string, hash: string, svc: string}'
        # Params of the window of TorrServer in the player (aio_tsi_params, ts_info.php).
        AioTsiParams: 'array{h: string, n: string, l: string, e: string}'
        # A stream request (aio_fetch, main.php).
        AioFetch: 'array{rows: list<AioRow>, errors: AioErrors}|array{error: string, detail: string, errors?: AioErrors}'
        # Progress of the releases of a list (aio_wh_progress, history.php):
        # the tail of our uid of the history after "aio:<dune id>:<s>:<e>:" =>
        # share in (0, 1]. Our uids end in an infoHash (40 hex: a string key);
        # a record of the history not written by us may end in a decimal
        # number, which PHP makes an int key - no infoHash matches it.
        AioProgress: 'array<int|string, float>'
        # Words of the list screen (aio_gc_text, view_gcomps.php).
        AioGcText: '''
            array{
                lang: string, page: string, pack: string, group: string, source: string,
                cached: string, cached_in: string, cached_and: string, download: string, unknown: string, p2p: string,
                video: string, audio: string, voices: string, subs: string, langs: string,
                trackers: string, addon: string, flip: string, actions: string, details: string,
                sort_aio: string, sort_seeds: string, sort_cached: string, sort_size: string, sort_date: string, errors: string
            }
        '''
        # Columns of the list (aio_gc_cols, view_gcomps.php): x and width;
        # an empty column is not there.
        AioGcCols: '''
            array{
                icon: array{int, int},
                res?: array{int, int},
                src?: array{int, int},
                vis?: array{int, int},
                audio?: array{int, int},
                size?: array{int, int},
                langs?: array{int, int},
                tracker?: array{int, int}
            }
        '''
        # GComps of the shell (gcomps.php). GCompAlignDef: its non-zero
        # fields only (aio_gc_align).
        AioGcAlign: 'array<string, bool|int|string>'
        # GCompGeometryDef (aio_gc_geom).
        AioGcGeom: 'array{w: int, h: int, align_def?: AioGcAlign}'
        # GComponentDef of a label, rect, picture or panel (aio_gc_ttf,
        # aio_gc_rect, aio_gc_image, aio_gc_panel); specific_def by the kind.
        AioGcComp: '''
            array{
                id?: string|null,
                geom_def: AioGcGeom,
                margins_def?: null,
                options?: int,
                kind: string,
                specific_def: array<string, mixed>
            }
        '''
        # ChangeGCompDef of change_gcomps (aio_gc_change).
        AioGcChange: '''
            array{
                id: string,
                geom_def: AioGcGeom|null,
                props: null,
                view_position: null,
                selected: null,
                children: list<AioGcComp>|null,
                transition: string
            }
        '''
        # A column of page 1 of the details screen (aio_info_col, view_info.php):
        # its x, the y of the next field, its bottom, the x of values, its
        # components so far (aio_info_put adds the fields), how many tracks
        # it does not show whole (aio_info_col_tracks; else 0).
        AioInfoCol: 'array{x: int, y: int, end: int, lw: int, d: list<AioGcComp>, hid: int}'
        # Subtitles of page 1 (aio_info_subs, view_info.php): the label with
        # the count of all, the tracks wrapped (else []), the languages joined
        # by ", " (else ''), the count of all, the lines the middle column
        # gives them at most.
        AioInfoSubs: 'array{label: string, st: list<list<string>>, codes: string, n: int, lines: int}'
        # The middle column of page 1 before its layout (aio_info_mid,
        # view_info.php): the column with its head, the voices, their first
        # group alone, the label of the audio, its tracks wrapped, their count.
        AioInfoMid: 'array{col: AioInfoCol, voices: string, alone: bool, alabel: string, audio: list<list<string>>, n_audio: int}'
        # Voices of one release name (aio_voices_parse, voices_parse.php):
        # type ids (dub, mvo, dvo, avo) in the order of the name, studios
        # shown, orig '' | 'orig' | 'jap', the name without JacRed's tails,
        # keys: studio => its key of voices.php, stype: studio => its type id.
        AioVoicesName: '''
            array{
                types: list<string>,
                studios: list<string>,
                orig: string,
                subs: bool,
                name: string,
                keys: array<string, string>,
                stype: array<string, string>
            }
        '''
        # Voices of a row from its names (aio_voices, voices_parse.php); ua:
        # "(УКР.)" in a name (aio_row_voices).
        AioVoices: '''
            array{
                types: list<string>,
                studios: list<string>,
                orig: string,
                subs: bool,
                stype: array<string, string>,
                ua?: true
            }
        '''
        # What the "Voices" field shows (aio_row_voices_struct,
        # voices_parse.php): groups: type id (dub, mvo, dvo, avo) => its
        # studios, types without studios, studios without a type.
        AioVoicesStruct: '''
            array{
                groups: array<string, list<string>>,
                types: list<string>,
                studios: list<string>,
                orig: string,
                subs: bool
            }
        '''
        # Tokens of a name (aio_voices_tokens, voices_parse.php), by word from
        # 0: as written, lower case, the joint to the next, the separator after
        # it, its part between "|", its depth in brackets, inside the leading
        # "[...]"; then where each "|" is, from 1.
        AioVoicesTokens: '''
            array{
                list<string>,
                list<string>,
                list<string>,
                list<string>,
                list<int>,
                list<int>,
                list<bool>,
                array<int, int>
            }
        '''
        # What a word of a name is (aio_voices_classes, voices_parse.php):
        # kind and id; a studio: its name shown and its key.
        AioVoicesClass: '''
            array{'studio', string, string}
            |array{'in'|'n', ''}
            |array{'code', string}
            |AioVoicesWord
        '''
        # A word by itself (aio_voices_word, voices_parse.php): kind and id.
        AioVoicesWord: "array{'type'|'orig'|'subs', string}"
        # A side of brackets of a track title (aio_voices_side, voices_parse.php).
        AioVoicesSide: 'array{studios: list<string>, n: int, other: bool}'
        # The meta of a title for its own card (aio_cm_parse, card_meta.php).
        AioCardMeta: 'array{type: string, id: string, imdb: string, tile: AioCatTile|null, original: string, description: string, tagline: string, released: string, studios: list<string>, networks: list<string>, status: string, countries: list<string>, cast: list<AioCardActor>, directors: list<string>, writers: list<string>, seasons: array<int, list<AioCardEp>>, season_numbers: array<int, int>}'
        # A card of the own card screen in memory (AioOc::$cards, view_card.php).
        AioOcCard: 'array{tile: AioCatTile, meta: AioCardMeta|null, imdb: string, dune: string, lang: string, ui: string, pos: AioOcPos, n: int, nav?: AioOcNav}'
        # A place of the focus on the own card, in AioOcCard and in sel_state (aio_oc_pos, view_card.php).
        AioOcPos: 'array{z: string, b: int, p: int, s: int, e: int}'
        # What the keys of the own card need of its layout (view_card.php).
        AioOcNav: 'array{kind: string, btns: list<array{string, string, bool}>, btn_y: int, stops: list<int>, clips: list<int>, h: int, off: int, zones: list<string>, tabs: AioOcTabs, ep: AioOcEp|null, prog: array<string, array{float, float, bool}>, first: list<array<string, mixed>>}'
        # The own card laid out (aio_oc_layout, view_card.php).
        AioOcLayout: 'array{kind: string, btns: list<array{string, string, bool}>, btn_y: int, stops: list<int>, clips: list<int>, h: int, off: int, zones: list<string>, tabs: AioOcTabs, ep: AioOcEp|null, prog: array<string, array{float, float, bool}>, first: list<array<string, mixed>>, down: list<array<string, mixed>>}'
        # The tabs of the seasons of a series card (aio_oc_tabs_layout, view_card_series.php).
        AioOcTabs: 'array{list: list<array{int, string, int, int}>, x: int, w: int, all: int, word: int}'
        # The episode a series card offers (aio_oc_pick, view_card_series.php).
        AioOcEp: 'array{q: int, e: int, s: int, hash: string, kind: string}'
        # An actor of the own card (aio_cm_people, card_meta.php).
        AioCardActor: 'array{name: string, role: string, photo: string}'
        # An episode of the own card (aio_cm_eps, card_meta.php).
        AioCardEp: 'array{s: int, e: int, title: string, date: string, img: string, min: int, soon: bool}'
