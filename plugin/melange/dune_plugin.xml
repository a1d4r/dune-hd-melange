<dune_plugin>
  <name>melange</name>
  <caption>%tr%plugin_caption</caption>
  <type>php</type>
  <permissions>
    <permission name="gcomps"/>
  </permissions>
  <params>
    <program>main.php</program>
    <movie_suppliers>aio</movie_suppliers>
  </params>
  <entry_points>
    <entry_point>
      <parent_media_url>setup://applications</parent_media_url>
      <media_url>setup</media_url>
      <caption>%tr%plugin_caption</caption>
      <icon_url>plugin_file://icons/logo.png</icon_url>
      <ip_address_required>no</ip_address_required>
      <valid_time_required>no</valid_time_required>
      <actions>
        <key_enter>
          <type>plugin_open_folder</type>
          <data>
            <media_url>setup</media_url>
            <caption>%tr%plugin_caption</caption>
          </data>
        </key_enter>
      </actions>
    </entry_point>
    <entry_point>
      <parent_media_url>root://applications</parent_media_url>
      <media_url>setup</media_url>
      <caption>%tr%plugin_caption</caption>
      <icon_url>plugin_file://icons/logo.png</icon_url>
      <ip_address_required>no</ip_address_required>
      <valid_time_required>no</valid_time_required>
      <actions>
        <key_enter>
          <type>plugin_open_folder</type>
          <data>
            <media_url>setup</media_url>
            <caption>%tr%plugin_caption</caption>
          </data>
        </key_enter>
      </actions>
      <popup_menu>
        <menu_items>
          <menu_item>
            <caption>%tr%setup_menu</caption>
            <icon_url>gui_skin://small_icons/setup.aai</icon_url>
            <action>
              <type>plugin_handle_user_input</type>
              <params>
                <handler_id>aio</handler_id>
                <control_id>setup</control_id>
              </params>
            </action>
          </menu_item>
        </menu_items>
      </popup_menu>
    </entry_point>
  </entry_points>
  <global_actions>
    <uninstall>
      <type>plugin_system</type>
      <data>
        <run_string>bin/uninstall.sh</run_string>
      </data>
    </uninstall>
  </global_actions>
  <check_update>
    <schema>2</schema>
    <url>https://a1d4r.github.io/dune-hd-melange/melange/update_info.xml</url>
    <timeout>86400</timeout>
    <required>no</required>
    <auto>yes</auto>
  </check_update>
  <version>0.41.0</version>
  <version_index>82</version_index>
</dune_plugin>
